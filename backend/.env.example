APP_NAME=DonaConecta API
APP_ENV=development
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=.\SQLEXPRESS
DB_NAME=DonaConectaDB_Pruebas
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=yes
DB_TRUST_CERT=yes
# Para pruebas se usa la base sintética. Nunca habilitar en DonaConectaDB sin autorización.
ALLOW_MAIN_DB_WRITES=no
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Genera un valor aleatorio largo y guárdalo solo en tu archivo .env local.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# AES-256-GCM del celular: 32 bytes en Base64. Genera tu propia clave local;
# nunca la subas al repositorio. Sin clave, el celular no se almacena.
TELEFONO_CLAVE_BASE64=
TELEFONO_CLAVE_VERSION=1
